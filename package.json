{
  "name": "dsh-qq-channel",
  "version": "0.2.0",
  "description": "Route allow-listed QQ private messages into an isolated dsh workspace through OneBot 11.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riki-forsure/dsh-napcatqq-remote.git"
  },
  "homepage": "https://github.com/riki-forsure/dsh-napcatqq-remote#readme",
  "bugs": {
    "url": "https://github.com/riki-forsure/dsh-napcatqq-remote/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "qq",
    "napcat",
    "onebot11"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "config.example.json",
    "README.md",
    "QUICKSTART.md",
    "NAPCAT_SETUP.md",
    "INSTALLATION.md",
    "AGENTS.md",
    "contact-style.example.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.6 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-attachment": { "optional": true },
    "@deepseek-ai/dsh-agent-presets": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session-persistence": { "optional": true },
    "@deepseek-ai/dsh-workspace": { "optional": true }
  },
  "license": "MIT"
}
